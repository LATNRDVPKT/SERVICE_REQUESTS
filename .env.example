# Copy this file to ".env" in the project root and fill in your real values.
# Never commit the real ".env" file to version control.

# --- Django core -------------------------------------------------------
DJANGO_SECRET_KEY="dev-secret-key-change-in-production-ais140-2026"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- MySQL database ------------------------------------------------------
DB_NAME="service_requests"
DB_USER="root"
DB_PASSWORD="replace-with-your-db-password"
DB_HOST="127.0.0.1"
DB_PORT=3306

EMAIL_BACKEND="django.core.mail.backends.console.EmailBackend"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER="replace-with-your-email-address"
EMAIL_HOST_PASSWORD="replace-with-your-email-app-password"
DEFAULT_FROM_EMAIL="replace-with-your-email-address"

# --- iAlert / Ashok Leyland outbound push -------------------------------
IALERT_BASE_URL=https://ialert.example.com/api/ais140/update
IALERT_TOKEN_HEADER_VALUE=replace-with-your-ialert-bearer-token

# --- Darby asset-search API (REQ-13) ------------------------------------
DARBY_SEARCH_URL=https://api.al.drivewithdarby.com/v1/assets/dynamic/search
DARBY_BEARER_TOKEN=replace-with-your-darby-bearer-token
DARBY_REQUEST_TIMEOUT=10

LOG_LEVEL=INFO
