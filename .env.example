# Copy this file to ".env" in the project root and fill in your real values.
# Never commit the real ".env" file to version control.

# --- Django core -------------------------------------------------------
DJANGO_SECRET_KEY="dev-secret-key-change-in-production-ais140-2026"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- MySQL database ------------------------------------------------------
DB_NAME="service_requests"
DB_USER="root"
DB_PASSWORD="replace-with-your-db-password"
DB_HOST="127.0.0.1"
DB_PORT=3306

# --- Email (SMTP via Gmail) ----------------------------------------------
EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER="replace-with-your-email-address"
EMAIL_HOST_PASSWORD="replace-with-your-email-app-password"
DEFAULT_FROM_EMAIL="replace-with-your-email-address"

# --- crsc_calls -> AL iAlert push (token-generate-then-push flow) -------
# Login/push URLs already default to the real AL endpoints in settings.py —
# only override if AL gives you different ones.
CRSC_IALERT_LOGIN_URL=https://ialertoperation.ashokleyland.com/operation/ialertelite/api/login/generate-token
CRSC_IALERT_PUSH_URL=https://ialertoperation.ashokleyland.com/operation/ialertelite/api/supportticket/support-ticket-status
CRSC_IALERT_LOGIN_TOKEN_HEADER_VALUE=replace-with-your-crsc-ialert-login-token

# --- AIS140_FLOW -> AL iAlert push (same flow, separate AL integration) --
AIS140_IALERT_LOGIN_URL=replace-with-your-ais140-ialert-login-url
AIS140_IALERT_PUSH_URL=replace-with-your-ais140-ialert-push-url
AIS140_IALERT_LOGIN_TOKEN_HEADER_VALUE=replace-with-your-ais140-ialert-login-token

# --- Darby asset-search API (REQ-13) ------------------------------------
DARBY_SEARCH_URL=https://api.al.drivewithdarby.com/v1/assets/dynamic/search
DARBY_BEARER_TOKEN=replace-with-your-darby-bearer-token
DARBY_REQUEST_TIMEOUT=10

LOG_LEVEL=INFO
